    E -->|"[A] TxPool::select(context, limits)"| S["Resolve eligible types for epoch/lane<br/>pack ready txs within limits"]
    T -.->|"retained type pools"| S
    S -->|"Payload"| B["Execution<br/>[C] TransactionBlock::from_context"]
    B --> P["Producer block"]
